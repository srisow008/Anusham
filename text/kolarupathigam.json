{
  "title": "Kolaru Pathigam",
  "language": "Tamil",
  "structure": {
    "intro": [
      "வேயுறு தோளி பங்கன் விடமுண்ட கண்டன்",
      "மிக நல்ல வீணை தடவி",
      "மாசறு திங்கள் கங்கை முடிமேல் அணிந்தென்",
      "உளமே புகுந்த அதனால்"
    ],
    "refrain": [
      "ஞாயிறு திங்கள் செவ்வாய் புதன் வியாழன் வெள்ளி சனி பாம்பு இரண்டும் உடனே",
      "ஆசறு நல்ல நல்ல அவை நல்ல நல்ல",
      "அடியார் அவர்க்கு மிகவே"
    ],
    "verses": [
      {
        "verse": 2,
        "lines": [
          "என்பொடு கொம்பொடு ஆமை இவை மார்பிலங்க",
          "எருதேறி ஏழை உடனே",
          "பொன்பொதி மத்த மாலை புனல்சூடி வந்தென்",
          "உளமே புகுந்த அதனால்"
        ]
      },
      {
        "verse": 3,
        "lines": [
          "உருவளர் பவளமேனி ஒளிநீறு அணிந்து",
          "உமையோடும் வெள்ளை விடைமேல்",
          "முருகலர் கொன்றை திங்கள் முடிமேல் அணிந்தென்",
          "உளமே புகுந்த அதனால்"
        ]
      },
      {
        "verse": 4,
        "lines": [
          "மதிநுதல் மங்கை யோடு வடபால் இருந்து",
          "மறையோதும் எங்கள் பரமன்",
          "நதியொடு கொன்றை மாலை முடிமேல் அணிந்தென்",
          "உளமே புகுந்த அதனால்"
        ]
      },
      {
        "verse": 5,
        "lines": [
          "நஞ்சணி கண்டன் எந்தை மடவாள் தனோடும்",
          "விடையேறு நங்கள் பரமன்",
          "துஞ்சிருள் வன்னி கொன்றை முடிமேல் அணிந்தென்",
          "உளமே புகுந்த அதனால்"
        ]
      },
      {
        "verse": 6,
        "lines": [
          "வாள்வரி அதள தாடை வரிகோவணத்தர்",
          "மடவாள் தனோடும் உடனாய்",
          "நாள்மலர் வன்னி கொன்றை நதிசூடி வந்தென்",
          "உளமே புகுந்த அதனால்"
        ]
      },
      {
        "verse": 7,
        "lines": [
          "செப்பிள முலை நன்மங்கை ஒருபாகம் ஆக",
          "விடையேறு செல்வன் அடைவார்",
          "ஒப்பிள மதியும் அப்பும் முடிமேல் அணிந்தென்",
          "உளமே புகுந்த அதனால்"
        ]
      },
      {
        "verse": 8,
        "lines": [
          "வேல்பட விழிசெய் தன்று விடைமேல் இருந்து",
          "மடவாள் தனோடும் உடனாய்",
          "வான்மதி வன்னி கொன்றை மலர்சூடி வந்தென்",
          "உளமே புகுந்த அதனால்"
        ]
      },
      {
        "verse": 9,
        "lines": [
          "பலபல வேடம் ஆகும் பரமன் அரியார்",
          "பதியார் சடையார் விடையேறி",
          "மலரொடு திங்கள் கங்கை முடிமேல் அணிந்தென்",
          "உளமே புகுந்த அதனால்"
        ]
      },
      {
        "verse": 10,
        "lines": [
          "கொத்தலர் குழலியோடு விசயற்கு நல்கு",
          "குணமாய வேட விகிர்தன்",
          "மத்தமும் மதியும் நாகம் முடிமேல் அணிந்தென்",
          "உளமே புகுந்த அதனால்"
        ]
      }
    ],
    "outro": [
      "ஞாயிறு திங்கள் செவ்வாய் புதன் வியாழன் வெள்ளி சனி பாம்பு இரண்டும் உடனே",
      "ஆசறு நல்ல நல்ல அவை நல்ல நல்ல",
      "அடியார் அவர்க்கு மிகவே"
    ]
  }
}
